{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "K501-INTEGRATED-INDEX-SCHEMA-1.0",
  "type": "object",
  "required": ["schema_id", "artifact_id", "version", "classification", "scope_note", "entries"],
  "properties": {
    "schema_id": {"type": "string", "const": "K501_INTEGRATED_INDEX/1.0"},
    "artifact_id": {"type": "string"},
    "version": {"type": "string", "const": "3.5.0"},
    "classification": {"type": "string", "const": "DERIVED_NAVIGATION_METADATA"},
    "scope_note": {"type": "string"},
    "entries": {"type": "array", "items": {"type": "object", "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string"}, "bytes": {"type": "integer"}, "sha256": {"type": "string"}}}}
  },
  "additionalProperties": true
}
